---
import { Icon } from 'astro-icon/components'
import MenuToggle from './MenuToggle.astro'
import MobileMenu from './MobileMenu.astro'
import NavLinks from './NavLinks.astro'
import ThemeToggle from './ThemeToggle.astro'

const nav = [
  { href: '/', label: 'Home' },
  { href: '/usage/', label: 'Usage' },
  { href: '/props/', label: 'Props' },
  { href: '/examples/', label: 'Examples' },
  { href: '/a11y/', label: 'Accessibility' },
]
---
<div class="sticky top-0 z-10">
  <header class="border-b border-border bg-bg/90 backdrop-blur">
    <nav aria-label="Primary" class="mx-auto flex w-full max-w-4xl items-center gap-6 px-6 py-4">
      <a href="/" class="flex items-center gap-2.5 font-display font-semibold">
        <span
          class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-accent to-accent-2 text-white shadow-[0_4px_12px_-2px_var(--color-glow)]"
          aria-hidden="true"
        >
          <Icon name="lucide:move-horizontal" class="h-4 w-4" />
        </span>
        <span class="hidden sm:inline">react-touch-drag-slider</span>
        <span class="sm:hidden">slider</span>
      </a>
      <div class="ml-auto flex items-center gap-5 text-sm">
        <div class="hidden items-center gap-5 md:flex">
          <NavLinks items={nav} />
        </div>
        <ThemeToggle />
        <MenuToggle />
      </div>
    </nav>
  </header>
  <MobileMenu items={nav} />
</div>