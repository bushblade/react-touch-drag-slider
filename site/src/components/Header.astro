---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/usage/', label: 'Usage' },
  { href: '/props/', label: 'Props' },
  { href: '/examples/', label: 'Examples' },
  { href: '/a11y/', label: 'Accessibility' },
]
---
<header class="sticky top-0 z-10 border-b border-neutral-200 bg-white/90 backdrop-blur">
  <nav class="mx-auto flex w-full max-w-4xl items-center gap-6 px-6 py-4">
    <a href="/" class="font-semibold">react-touch-drag-slider</a>
    <div class="ml-auto flex gap-5 text-sm">
      {
        nav.map((item) => (
          <a href={item.href} class="text-neutral-600 hover:text-neutral-900">
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
