---
import { Icon } from 'astro-icon/components'
---
<button
  type="button"
  id="menu-toggle"
  aria-label="Toggle navigation menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
  class="rounded-lg p-2 text-fg-muted transition-colors hover:text-accent md:hidden"
>
  <Icon
    id="menu-icon-open"
    name="lucide:menu"
    class="block h-5 w-5"
    aria-hidden="true"
  />
  <Icon
    id="menu-icon-close"
    name="lucide:x"
    class="hidden h-5 w-5"
    aria-hidden="true"
  />
</button>