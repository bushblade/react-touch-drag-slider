---
---
<button
  type="button"
  id="menu-toggle"
  aria-label="Toggle navigation menu"
  aria-expanded="false"
  aria-controls="mobile-menu"
  class="rounded p-1.5 text-fg-muted transition-colors hover:text-accent md:hidden"
>
  <svg
    id="menu-icon-open"
    class="block h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 6h16M4 12h16M4 18h16" />
  </svg>
  <svg
    id="menu-icon-close"
    class="hidden h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M6 6l12 12M18 6L6 18" />
  </svg>
</button>