---
import '@fontsource-variable/inter'
import '@fontsource-variable/space-grotesk'
import '@fontsource/jetbrains-mono/400.css'
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'

const { title = 'react-touch-drag-slider' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Docs and demos for react-touch-drag-slider, a touch and drag slider carousel component for React."
    />
    <title>
      {title === 'react-touch-drag-slider'
        ? title
        : `${title} · react-touch-drag-slider`}
    </title>
    <script is:inline>
      ;(() => {
        const stored = localStorage.getItem('theme')
        const dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches
        if (dark) document.documentElement.classList.add('dark')
      })()
    </script>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip bg-bg text-fg antialiased">
    <Header />
    <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>